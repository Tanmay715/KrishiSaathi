NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

DB_HOST=127.0.0.1
# Docker dev DB uses port 3307 (avoids conflict with any local/office MySQL on 3306)
DB_PORT=3307
DB_USER=root
DB_PASSWORD=krishisaathi
DB_NAME=krishisaathi

REDIS_HOST=127.0.0.1
# Docker dev Redis uses port 6380 (avoids conflict with system Redis on 6379)
REDIS_PORT=6380

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
# Closed pilot only: show OTP in API response when SMS is not wired yet
OTP_PILOT_MODE=false
# Set when SMS provider is integrated (e.g. msg91, twilio)
SMS_PROVIDER=

CORS_ORIGIN=http://localhost:5173,http://localhost:3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: live AGMARKNET mandi rates via data.gov.in
DATA_GOV_API_KEY=
DATA_GOV_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
