{
  "name": "krishisaathi-backend",
  "version": "0.1.0",
  "description": "KrishiSaathi farm management API",
  "main": "src/server.js",
  "scripts": {
    "start": "npm run migrate && node src/server.js",
    "release": "npm run migrate",
    "dev": "nodemon src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "db:check": "node scripts/check_db.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "setup": "bash scripts/setup_dev.sh"
  },
  "keywords": [
    "farm-management",
    "agriculture",
    "krishisaathi"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "mysql2": "^3.22.5",
    "openai": "^6.46.0",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
